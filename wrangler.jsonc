{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "copy-check-api",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-11-10",
  "ratelimits": [
    {
      "name": "AUDIT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  "observability": {
    "enabled": true
  }
}
